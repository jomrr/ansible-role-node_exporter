{{ ansible_managed | comment(prefix_count=0, postfix_count=0) }}
# file: {{ template_destpath }}

[Unit]
Description=Prometheus Node Exporter
Wants=network-online.target
After=network-online.target

[Service]
User=node_exporter
EnvironmentFile=/etc/node_exporter/node_exporter.env
ExecStart={{ __node_exporter_executable }} --web.listen-address ${LISTEN_ADDRESS} $COLLECTORS $WEB_CONFIG
NoNewPrivileges=true
CapabilityBoundingSet=
ProtectSystem=strict
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
Restart=on-failure

[Install]
WantedBy=multi-user.target
